{
  "name": "cdk-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "build:env": "npm run build:env --workspaces",
    "test": "npm run test --workspaces",
    "test:env": "npm run test:env --workspaces",
    "cdk": "cd packages/infrastructure && npx aws-cdk",
    "deploy": "cd packages/infrastructure && npx aws-cdk deploy --all",
    "deploy:frontend": "cd packages/infrastructure && npx aws-cdk deploy FrontendStack",
    "deploy:backend": "cd packages/infrastructure && npx aws-cdk deploy GraphProcessingStack",
    "deploy:medkg": "cd packages/infrastructure && npx aws-cdk deploy MedKnowledgeGraphStack",
    "deploy:all": "cd packages/infrastructure && npx aws-cdk deploy --all",
    "synth": "cd packages/infrastructure && npx aws-cdk synth",
    "bootstrap": "cd packages/infrastructure && npx aws-cdk bootstrap",
    "frontend:start": "cd packages/frontend && npm run start:env",
    "frontend:build": "cd packages/frontend && npm run build:env",
    "lambda:test": "cd packages/lambda && npm run local:test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "AWS CDK Monorepo with TypeScript Lambda and React Frontend",
  "engines": {
    "node": ">=18.0.0"
  }
}
