# Inherit from root .env via ${VAR} expansion
CDK_DEFAULT_ACCOUNT=${AWS_ACCOUNT_ID}
CDK_DEFAULT_REGION=${AWS_REGION}
AWS_PROFILE=default

# Neptune serverless settings
NEPTUNE_ENGINE_VERSION=1.2.1.0
NEPTUNE_MIN_CAPACITY=1.0
NEPTUNE_MAX_CAPACITY=8.0

# Resource naming (optional explicit overrides)
S3_GRAPH_DATA_BUCKET_NAME=graph-rag-data-dev
S3_WEBSITE_BUCKET_NAME=graph-rag-frontend-dev
S3_MEDICAL_DATA_BUCKET_NAME=graph-rag-medical-dev
CLOUDFRONT_PRICE_CLASS=PriceClass_100
