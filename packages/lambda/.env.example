# Copy to packages/lambda/.env for local lambda testing

# Required for chat_handler.py (do not commit real secrets)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Optional overrides
GEMINI_MODEL=gemini-1.5-pro
LOG_LEVEL=INFO

# Neptune settings for non-mock execution paths
NEPTUNE_ENDPOINT=your-neptune-endpoint
NEPTUNE_PORT=8182
